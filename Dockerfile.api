FROM python:3.11-slim

# Mets la même version de Python que celle affichée à l'étape 1
WORKDIR /app/streamlit

# Bibliothèques système (xgboost a besoin de libgomp)
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# 1. PyTorch version CPU (beaucoup plus léger que la version GPU)
#    Remplace "torch" par "torch==<version>" si tu veux la même que ton env
RUN pip install --no-cache-dir torch==2.2.2 --index-url https://download.pytorch.org/whl/cpu

# 2. Reste des dépendances
COPY requirements-api.txt /tmp/requirements-api.txt
RUN pip install --no-cache-dir -r /tmp/requirements-api.txt

# 3. Code : on garde la même arborescence que sur ta machine
#    (fraud_api.py calcule ../models, ../feast_repo et ../prometheus à partir de son emplacement)
COPY streamlit/fraud_api.py /app/streamlit/fraud_api.py
COPY prometheus/__init__.py /app/prometheus/__init__.py
COPY prometheus/metrics.py  /app/prometheus/metrics.py

# models/ et feast_repo/ ne sont PAS copiés : ils seront montés en volumes

ENV FEAST_USAGE=False
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=90s \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

CMD ["uvicorn", "fraud_api:app", "--host", "0.0.0.0", "--port", "8000"]